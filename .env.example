# Copy to .env and fill in. Never commit .env. See BOUWPLAN.md, chapter 17.

# General
NODE_ENV=
PORT=
APP_BASE_URL=
DATABASE_URL=
DEFAULT_TIMEZONE=
# Tests only: a Postgres role with CREATEDB; integration tests create and drop a throwaway database
TEST_DATABASE_URL=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_SMART=
CLAUDE_EFFORT_FAST=
CLAUDE_EFFORT_SMART=

# Transcription
OPENAI_API_KEY=
TRANSCRIBE_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random, 32+ characters (A-Z, a-z, 0-9, _ and -)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user ids
TELEGRAM_ALLOWED_USER_IDS=

# Mail
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Random; part of the inbound webhook path
EMAIL_INBOUND_SECRET=
# Comma-separated addresses
EMAIL_ALLOWED_SENDERS=
# Inbound mail with a higher Brevo SpamScore is ignored (default 5)
EMAIL_MAX_SPAM_SCORE=
# Random, 32+ characters; signs action links in mails
ACTION_LINK_SECRET=

# Research: claude (default) or perplexity
RESEARCH_PROVIDER=
PERPLEXITY_API_KEY=

# Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Phase 3
MOLLIE_API_KEY=
ENCRYPTION_KEY=
