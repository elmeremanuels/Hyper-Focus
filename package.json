{
  "name": "hyperfocus",
  "version": "0.1.0",
  "private": true,
  "description": "Hyper&Focus: AI project manager and assistant via Telegram and mail",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/ai/prompts','dist/ai/prompts',{recursive:true})\" && vite build --config web/vite.config.ts && vite build --config site/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "demo:week": "tsx scripts/demo-week.ts",
    "site:shots": "tsx scripts/site-shots.ts",
    "sim": "tsx scripts/sim.ts",
    "eval": "tsx scripts/eval.ts",
    "sim:day": "tsx scripts/sim-day.ts",
    "stats:focus": "tsx scripts/stats-focus.ts",
    "link:telegram": "tsx scripts/link-telegram.ts",
    "telegram:webhook": "tsx scripts/telegram-webhook.ts",
    "brevo:inbound": "tsx scripts/brevo-inbound.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "google-auth-library": "^11.1.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "openai": "^7.25.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
