{
  "name": "hyperfocus",
  "version": "0.1.0",
  "private": true,
  "description": "Hyper&Focus: AI project manager and assistant via WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "google-auth-library": "^11.1.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "openai": "^7.25.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
